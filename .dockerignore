# Git & IDE
.git
.gitignore
.gitattributes
.cursor
.idea
.vscode
*.swp
*.swo
.DS_Store

# Dependencies (sẽ cài trong container)
node_modules
vendor

# Env (không đưa vào image; dùng env_file hoặc mount)
.env
.env.*
!.env.example
!.env.production.example

# Logs & cache (tránh copy vào image)
storage/logs/*
!storage/logs/.gitkeep
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
!.gitkeep

# Test & dev
tests
phpunit.xml
.phpunit.result.cache
phpstan.neon
phpstan-baseline.neon
.php-cs-fixer.cache
.husky
.lintstagedrc.json

# Docs (tùy chọn: bỏ nếu cần trong image)
docs
*.md
!readme.md

# Docker (tránh recursive)
Dockerfile
docker-compose*.yml
.dockerignore

# Optional: WASM binaries nếu build riêng
# wasm/*.wasm
