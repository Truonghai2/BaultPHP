# Observability Configuration Template
# Copy relevant settings to your .env file

# OpenTelemetry
OBSERVABILITY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=baultframe
OTEL_SERVICE_VERSION=1.0.0

# Tracing
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=1.0
TRACE_HTTP=true
TRACE_DATABASE=true
TRACE_CQRS=true
TRACE_CACHE=false

# Metrics
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
METRICS_PORT=9091
METRICS_RECORD_HTTP=true
METRICS_RECORD_DATABASE=true
METRICS_RECORD_CQRS=true
METRICS_RECORD_CACHE=true

# Jaeger
JAEGER_ENABLED=true
JAEGER_HOST=localhost
JAEGER_PORT=16686

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_NAMESPACE=baultframe

# Grafana
GRAFANA_ENABLED=true
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Projections
PROJECTIONS_ENABLED=true
PROJECTIONS_STOP_ON_ERROR=false
PROJECTIONS_BATCH_SIZE=100
PROJECTIONS_POLL_INTERVAL=1000
PROJECTIONS_AUTO_START=false
