parameters:
    ignoreErrors:
        # Swoole may not be available during static analysis
        -
            message: '#Undefined function .+Swoole.+#'
            path: src/Core/Http/FormRequest.php
        -
            message: '#Undefined type .+Swoole.+#'
            paths:
                - src/Core/Http/FormRequest.php
                - src/Core/Server/CoroutineLimiter.php
                - src/Core/Server/RequestLifecycle.php
                - src/Core/Server/SwooleServer.php
                - src/Core/Server/ConnectionPoolManager.php
        # MessageBag is an object at runtime
        -
            message: "#Expected type 'object'. Found 'array'#"
            path: src/Core/Http/FormRequest.php
            count: 1
